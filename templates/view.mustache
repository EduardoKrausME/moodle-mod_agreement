{{!
    @template mod_agreement/view

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
{{#hasintro}}
<div class="mod-agreement-intro mb-4">
    {{{introhtml}}}
</div>
{{/hasintro}}

<div class="mod-agreement-term card mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <strong>{{#str}}termsection, mod_agreement{{/str}}</strong>
            <span class="badge bg-secondary">{{versionlabel}}</span>
        </div>
        <div class="mod-agreement-termtext">
            {{{termhtml}}}
        </div>
        <div class="small text-muted mt-3">{{versiondate}}</div>
    </div>
</div>

{{#canrespond}}
{{#hasresponse}}
<div class="alert {{#response.agreed}}alert-success{{/response.agreed}}{{^response.agreed}}alert-secondary{{/response.agreed}}">
    <strong>{{#str}}responserecorded, mod_agreement{{/str}}</strong>
    <div class="mt-1">{{response.label}}</div>
    <div class="small mt-1">{{#str}}respondedon, mod_agreement, {{response.date}}{{/str}}</div>
</div>
{{/hasresponse}}

{{^hasresponse}}
<form method="post" action="{{formaction}}" class="mod-agreement-response card mb-4">
    <div class="card-body">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="action" value="respond">

        <fieldset>
            <legend class="h5">{{#str}}response, mod_agreement{{/str}}</legend>
            <div class="form-check mb-2">
                <input class="form-check-input" type="radio" name="response" id="agreement-agree" value="1" required>
                <label class="form-check-label" for="agreement-agree">{{#str}}agree, mod_agreement{{/str}}</label>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="radio" name="response" id="agreement-disagree" value="0" required>
                <label class="form-check-label" for="agreement-disagree">{{#str}}disagree, mod_agreement{{/str}}</label>
            </div>
        </fieldset>

        <button type="submit" class="btn btn-primary">{{#str}}submitresponse, mod_agreement{{/str}}</button>
    </div>
</form>
{{/hasresponse}}

{{/canrespond}}

{{#canviewreport}}
<a href="{{reporturl}}" class="btn btn-outline-secondary">{{#str}}viewreport, mod_agreement{{/str}}</a>
{{/canviewreport}}
